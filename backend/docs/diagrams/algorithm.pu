@startuml VectorSearchAlgorithm

start

:Запрос: слова и их частоты (Counter);
:Данные: словари файлов {file_id: [SearchWordModel]};

partition "Подготовка данных" {
  :Создание word_idf_map;
  note right
    Для каждого слова из всех
    файлов сохраняем IDF значение
  end note
}

partition "Обработка запроса" {
  :Вычисление TF-IDF вектора запроса;
  note right
    TF = count / total_terms
    TF-IDF = TF * IDF
  end note
}

if (Вектор запроса пустой?) then (да)
  :Возврат пустого результата;
  stop
else (нет)
endif

partition "Обработка документов" {
  while (Для каждого файла) is (Обработать следующий файл)
  
    :Создание Counter для слов документа;
    
    :Вычисление TF-IDF вектора документа;
    
    :Вычисление косинусной меры;
    note right
      cosine_similarity = 
      dot_product / (doc_norm * query_norm)
    end note
    
    if (similarity > 0?) then (да)
      :Добавить (file_id, similarity) в результаты;
    else (нет)
      :Пропустить документ;
    endif
  endwhile
}

partition "Формирование результата" {
  :Сортировка результатов по убыванию similarity;
  :Возврат отсортированного списка (file_id, similarity);
}

stop

@enduml